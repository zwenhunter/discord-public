{
  "name": "discord-management-ecosystem",
  "version": "1.0.0",
  "description": "5 botlu profesyonel Discord yonetim ekosistemi (prefix tabanli)",
  "main": "bots/guard/index.js",
  "private": true,
  "engines": { "node": ">=18.17.0" },
  "scripts": {
    "setup": "node scripts/setup.js",
    "start": "pm2 start ecosystem.config.js && pm2 save",
    "stop": "pm2 stop ecosystem.config.js",
    "restart": "pm2 restart ecosystem.config.js",
    "status": "pm2 status",
    "logs": "pm2 logs",
    "delete": "pm2 delete ecosystem.config.js",
    "guard:start": "pm2 start ecosystem.config.js --only guard",
    "guard:stop": "pm2 stop guard",
    "guard:restart": "pm2 restart guard",
    "guard:logs": "pm2 logs guard",
    "moderation:start": "pm2 start ecosystem.config.js --only moderation",
    "moderation:stop": "pm2 stop moderation",
    "moderation:restart": "pm2 restart moderation",
    "moderation:logs": "pm2 logs moderation",
    "statistics:start": "pm2 start ecosystem.config.js --only statistics",
    "statistics:stop": "pm2 stop statistics",
    "statistics:restart": "pm2 restart statistics",
    "statistics:logs": "pm2 logs statistics",
    "guildtag:start": "pm2 start ecosystem.config.js --only guildtag",
    "guildtag:stop": "pm2 stop guildtag",
    "guildtag:restart": "pm2 restart guildtag",
    "guildtag:logs": "pm2 logs guildtag",
    "register:start": "pm2 start ecosystem.config.js --only register",
    "register:stop": "pm2 stop register",
    "register:restart": "pm2 restart register",
    "register:logs": "pm2 logs register",
    "bot:guard": "node bots/guard/index.js",
    "bot:moderation": "node bots/moderation/index.js",
    "bot:statistics": "node bots/statistics/index.js",
    "bot:guildtag": "node bots/guildtag/index.js",
    "bot:register": "node bots/register/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "node scripts/qqnlint.js",
    "lint:fix": "node scripts/qqnlint.js --fix",
    "format": "prettier --write \"bots/**/*.js\" \"shared/**/*.js\" \"scripts/**/*.js\""
  },
  "dependencies": {
    "discord.js": "^14.16.3",
    "mongoose": "^8.9.5",
    "dotenv": "^16.4.7",
    "winston": "^3.17.0",
    "zod": "^3.24.1",
    "ioredis": "^5.4.2"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "pm2": "^6.0.5",
    "vitest": "^2.1.8"
  }
}
